# Copy this file to .env and fill in the values (never commit .env).
# Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# true = run the dashboard on seeded demo data with a simulated camera
# (no Supabase, no sign-in needed). false = live Supabase + Realtime.
EXPO_PUBLIC_USE_MOCK_DATA=true

# Minutes an item stays "taken out" before it counts as used up.
EXPO_PUBLIC_PENDING_GRACE_MINUTES=10

# The AI key does NOT go here — it lives in Supabase Edge Function secrets.
